# ============================================================
#  Hermes Finance Agent — Variáveis de Ambiente
#  Copie este ficheiro para .env e preencha os valores
#  cp .env.example .env
# ============================================================

# ── JWT ──────────────────────────────────────────────────────
# Segredo para assinar os tokens JWT (mín. 32 caracteres)
JWT_SECRET=change-this-to-a-long-random-secret-string

# ── Email da Caixa de Faturas ─────────────────────────────────
# Endereço de email monitorizado pelo Hermes Agent
FINANCE_EMAIL_ADDRESS=faturas@empresa.com

# App Password do Gmail (não a password da conta Google)
# https://myaccount.google.com/apppasswords
FINANCE_EMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Servidores IMAP/SMTP (defaults para Gmail)
FINANCE_IMAP_HOST=imap.gmail.com
FINANCE_SMTP_HOST=smtp.gmail.com

# ── Hermes Agent (Nous Research) ─────────────────────────────
# Chave que o .NET Gateway usa para chamar a API do Hermes Agent
# e que o Hermes Agent usa para fazer POST de faturas ao Gateway
HERMES_AGENT_API_KEY=change-this-shared-secret

# Chave da API Server do Hermes Agent (endpoint GET /api/status, etc.)
HERMES_API_SERVER_KEY=change-this-agent-api-key

# ── MCP Server (integração bidirecional) ─────────────────────
HERMES_MCP_KEY=change-this-mcp-key
