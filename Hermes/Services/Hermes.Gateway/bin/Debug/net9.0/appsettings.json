{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=hermes_db;Username=postgres;Password=postgres"
  },
  "HermesAgent": {
    "BaseUrl": "http://localhost:8642",
    "ApiKey": ""
  },
  "ReverseProxy": {
    "Routes": {
      "hermes-identity": {
        "ClusterId": "hermes-identity",
        "Match": {
          "Path": "api/hermes/auth/{**catch-all}"
        }
      },
      "hermes-api": {
        "ClusterId": "hermes-services",
        "Match": {
          "Path": "api/hermes/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "hermes-identity": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "hermes-services": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001/"
          }
        }
      }
    }
  }
}
