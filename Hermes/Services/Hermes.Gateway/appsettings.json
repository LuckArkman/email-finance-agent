{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=hermes_db;Username=postgres;Password=postgres"
  },
  "HermesAgent": {
    "BaseUrl": "http://localhost:8642",
    "ApiKey": ""
  },
  "ReverseProxy": {
    "Routes": {
      "hermes-identity": {
        "ClusterId": "hermes-identity",
        "Match": { "Path": "api/hermes/auth/{**catch-all}" }
      },
      "hermes-analytics": {
        "ClusterId": "hermes-analytics-cluster",
        "Match": { "Path": "api/hermes/analytics/{**catch-all}" }
      },
      "hermes-reconciliation": {
        "ClusterId": "hermes-reconciliation-cluster",
        "Match": { "Path": "api/hermes/reconciliation/{**catch-all}" }
      },
      "hermes-extraction": {
        "ClusterId": "hermes-extraction-cluster",
        "Match": { "Path": "api/hermes/extraction/{**catch-all}" }
      }
    },
    "Clusters": {
      "hermes-identity": {
        "Destinations": {
          "destination1": { "Address": "http://hermes-identity:8080/" }
        }
      },
      "hermes-analytics-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://hermes-analytics:8080/" }
        }
      },
      "hermes-reconciliation-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://hermes-reconciliation:8080/" }
        }
      },
      "hermes-extraction-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://hermes-extraction:8080/" }
        }
      }
    }
  }
}
